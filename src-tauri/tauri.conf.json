{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ISCC C2PA Demo",
  "identifier": "codes.iscc.c2pa-demo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:43172",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ISCC C2PA Demo",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": true,
        "visible": false,
        "backgroundColor": "#F8F9FA"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb", "rpm"],
    "publisher": "ISCC Foundation",
    "copyright": "Copyright 2026 ISCC Foundation",
    "homepage": "https://c2pa-demo.iscc.codes",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "category": "DeveloperTool",
    "shortDescription": "Inspect and sign C2PA Content Credentials with ISCC soft bindings",
    "longDescription": "A desktop demo that shows the C2PA manifest of an image, document or audio file, computes its ISCC units and signs a copy with a C2PA manifest carrying an ISCC soft binding (IEP-0020).",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": [],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
