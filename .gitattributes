# Normalize line endings: check out as-is, commit as LF
* text=auto eol=lf

# Source code
*.rs text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# Config and data
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.cfg text eol=lf
*.lock text eol=lf
*.pem text eol=lf
*.pub text eol=lf
*.svg text eol=lf

# Documentation and text
*.md text eol=lf
*.txt text eol=lf

# Binary files (never normalize)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.tif binary
*.tiff binary
*.ico binary
*.icns binary
*.epub binary
*.docx binary
*.pptx binary
*.xlsx binary
*.odt binary
*.ods binary
*.odp binary
*.mp3 binary
*.flac binary
*.wav binary
*.m4a binary
*.mp4 binary
*.mov binary
*.m4v binary
*.avi binary
*.mp7sig binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
